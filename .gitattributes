# Normalise line endings to LF in the repository (Windows checkouts convert as needed).
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
