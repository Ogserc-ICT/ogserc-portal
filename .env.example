# OGSERC portal environment variables.
# Copy to .env and fill in real values. Never commit .env or put real secrets in this file.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. Local development uses a hosted dev database (e.g. a Neon branch).
# Use sslmode=verify-full for hosted databases.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Long random string (at least 32 characters; the server refuses to start otherwise) used to
# sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value in each environment (development, staging, production).
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public address of the site: the bare origin, e.g. https://example.gov.ng (no path, no trailing
# slash). Needed at build time and at run time. At build time: canonical links, link previews,
# robots.txt and sitemap.xml are built in advance (D-078), and a production build without it stops
# with an error. At run time: links and the CSRF check, which accepts signed-in requests only from
# this origin. When NODE_ENV=production it must be https: the server refuses to start with plain
# http except on localhost, 127.0.0.1 or [::1]. Behind a proxy that handles HTTPS, still use the
# public https:// address (docs/RUNBOOK.md Section 5).
SITE_URL=http://localhost:3000

# New staff passwords are checked against Have I Been Pwned's breach list (D-053); only the first
# 5 characters of the password's SHA-1 hash are sent. "off" skips the check (for working offline).
# Leave it unset on servers: the server warns at startup if it is off in production.
# PASSWORD_BREACH_CHECK=off

# --- Uploaded files ------------------------------------------------------------
# Optional: local folder for uploaded images until S3 storage is added in build step 4.
# Defaults to `media` in the working directory. `pnpm test:e2e:db` sets its own throwaway folder.
# MEDIA_DIR=media

# --- VPS deploy only (docker-compose.prod.yml, RUNBOOK Section 5) ----------------
# On the VPS, DATABASE_URL is not set here: compose builds it from POSTGRES_PASSWORD for the
# database container. Generate the password with `openssl rand -hex 32` (hex keeps it URL-safe).
# SITE_URL is then https://<SITE_DOMAIN>.
# POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Domain Caddy serves and gets the HTTPS certificate for, without https:// (www. redirects to it).
# SITE_DOMAIN=example.org.ng
# Where Let's Encrypt sends certificate expiry notices. Use a shared OGSERC IT mailbox.
# ACME_EMAIL=it@example.org.ng
# "off" only while the host's CPU cannot run sharp (D-056): images are then served unoptimised
# and uploads are not resized. Leave unset (on) everywhere else.
# IMAGE_PROCESSING=off
# Visitor statistics with Umami (D-077, RUNBOOK Section 5, step I). Generate the three secrets with
# `openssl rand -hex 32`, each one different. UMAMI_2FA_KEY enables two-factor sign-in.
# UMAMI_DB_PASSWORD=replace-with-openssl-rand-hex-32
# UMAMI_APP_SECRET=replace-with-openssl-rand-hex-32
# UMAMI_2FA_KEY=replace-with-openssl-rand-hex-32
# Healthchecks.io ping URLs (D-079, RUNBOOK Section 8): disk space every 30 minutes, nightly backup.
# Treat them like passwords: anyone with one could send false "all is well" pings.
# HC_DISK_PING_URL=https://hc-ping.com/replace-with-the-check-uuid
# HC_BACKUP_PING_URL=https://hc-ping.com/replace-with-the-check-uuid
# Encrypted off-server backup copies with restic (D-080, RUNBOOK Section 6). OFFSITE_PASSWORD
# encrypts them: keep it in the password manager, because without it the copies cannot be opened.
# OFFSITE_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/replace-with-bucket/ogserc
# OFFSITE_KEY_ID=replace-with-b2-key-id
# OFFSITE_KEY_SECRET=replace-with-b2-application-key
# OFFSITE_PASSWORD=replace-with-openssl-rand-hex-32

# --- Visitor statistics (optional) --------------------------------------------
# The website ID from Umami's dashboard (Settings, Websites). Not a secret. Empty leaves statistics
# off; set it only for the live site, never in development or CI with a real ID.
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# --- File storage (S3-compatible). Used from build step 4 (Media) -------------
# Any S3-compatible provider works (AWS S3, Cloudflare R2, Backblaze B2, MinIO, ...).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (contact form). Used from build step 5 ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_FORM_TO=

# --- Bot protection (Cloudflare Turnstile). Used from build step 5 -------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tests -------------------------------------------------------------------
# Database for `pnpm test:e2e:db`. It is EMPTIED at the start of every run. Use a separate
# database (e.g. its own Neon branch) whose name contains "e2e" or "test"; the tests refuse to run
# if it is missing, misnamed, or the same host and database as DATABASE_URL.
TEST_DATABASE_URL=postgres://USER:PASSWORD@TEST-HOST:5432/ogserc_e2e?sslmode=verify-full

# Never set this here or on any host. It registers test-only collections; the server refuses it in
# production. Only the migrate:create script and the tests set it (D-050).
# E2E_TEST_COLLECTIONS=

# Optional: run Playwright against an already running site instead of starting one.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
